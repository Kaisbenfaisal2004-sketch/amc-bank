rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Progress: only the owner account, only its own document per subject, only the expected shape.
    match /users/{uid}/progress/{bankId} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow write: if request.auth != null && request.auth.uid == uid
        && uid == 'VBdzQU3iKcSTV3XRRMUZGNqU0Fg1'
        && bankId.matches('^[a-z0-9-]{1,40}$')
        && request.resource.data.keys().hasOnly(['answers'])
        && request.resource.data.answers is map
        && request.resource.data.answers.size() <= 6000;
    }
    // Question banks: only the owner account.
    match /banks/{document=**} {
      allow read, write: if request.auth != null && request.auth.uid == 'VBdzQU3iKcSTV3XRRMUZGNqU0Fg1';
    }
    // Everything else: denied (Firestore default).
  }
}
