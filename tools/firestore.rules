rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // each account: only its own progress
    match /users/{uid}/{document=**} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }
    // question banks: only the owner account (Kais)
    match /banks/{document=**} {
      allow read, write: if request.auth != null && request.auth.uid == 'VBdzQU3iKcSTV3XRRMUZGNqU0Fg1';
    }
  }
}
